{
  "manifest_version": 3,
  "name": "Canvas Dashboard",
  "short_name": "Dashboard",
  "description": "A clean, private dashboard that works with Canvas. Not affiliated with Instructure or any school.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "action": {
    "default_title": "Canvas Dashboard",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "https://*.inscloudgate.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https:"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
